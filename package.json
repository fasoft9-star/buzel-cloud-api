{
  "name": "express-rest-api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "esbuild frontend/main.jsx --bundle --minify --outfile=public/assets/app.js",
    "start": "node --max-http-header-size=131072 src/server.js",
    "dev": "node --max-http-header-size=131072 --watch src/server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer-real-browser": "^1.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2"
  }
}
